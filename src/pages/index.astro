---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/landing/SiteNav.astro';
import Hero from '../components/landing/Hero.astro';
import Statement from '../components/landing/Statement.astro';
import BuildShowcase from '../components/landing/BuildShowcase.astro';
import StudioCards from '../components/landing/StudioCards.astro';
import WhatWeBuild from '../components/landing/WhatWeBuild.astro';
import Repositories from '../components/landing/Repositories.astro';
import DuskClose from '../components/landing/DuskClose.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
---

<Layout>
	<div id="top" class="overflow-x-clip bg-paper text-ink">
		<SiteNav />
		<main>
			<Hero />
			<Statement />
			<BuildShowcase />
			<StudioCards />
			<WhatWeBuild />
			<Repositories />
			<DuskClose />
		</main>
		<SiteFooter />
	</div>
</Layout>
