---
import Icon from '../landing/Icon.astro';
import type { Note } from '../../data/notes';

interface Props {
	note: Note;
	layout?: 'mosaic' | 'pair';
}

const { note, layout = 'mosaic' } = Astro.props;
const span =
	layout === 'pair' ? 'lg:col-span-6' : note.span === 7 ? 'lg:col-span-7' : note.span === 5 ? 'lg:col-span-5' : 'lg:col-span-6';
---

<a
	href={`/notes/${note.slug}`}
	data-note
	data-topic={note.topic}
	data-title={note.title}
	class:list={[
		'relative flex h-[380px] flex-col justify-between overflow-hidden rounded-xl p-7',
		span,
	]}
>
	<img src={note.image} alt="" class="absolute inset-0 size-full object-cover grayscale" />
	<span
		class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,color-mix(in_srgb,var(--color-canopy)_60%,transparent)_0%,color-mix(in_srgb,var(--color-canopy)_15%,transparent)_48%,color-mix(in_srgb,var(--color-canopy)_80%,transparent)_100%)]"
	></span>
	<span class="relative flex flex-col gap-4">
		<span class="flex items-center gap-4 font-label text-xs leading-none tracking-[0.06em] uppercase">
			<span class="text-gold">{note.category}</span>
			<span class="text-mist">{note.date}</span>
		</span>
		<span class="max-w-[520px] text-[2rem] leading-[1.14] tracking-[-0.025em] text-paper">{note.title}</span>
	</span>
	<span class="relative flex items-center justify-between text-paper">
		<span class="text-[15px] leading-none">{note.minutes} min read</span>
		<Icon name="arrow-right" class="size-[18px]" />
	</span>
</a>
