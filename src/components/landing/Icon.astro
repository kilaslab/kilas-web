---
interface Props {
	name:
		| 'arrow'
		| 'arrow-left'
		| 'arrow-right'
		| 'search'
		| 'chevron-down'
		| 'chevron-right'
		| 'file'
		| 'git'
		| 'check'
		| 'menu'
		| 'close';
	class?: string;
}

const { name, class: className = 'size-3.5' } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'arrow' && (
			<>
				<path d="M7 7h10v10" />
				<path d="M7 17 17 7" />
			</>
		)
	}
	{
		name === 'arrow-left' && (
			<>
				<path d="M19 12H5" />
				<path d="m12 19-7-7 7-7" />
			</>
		)
	}
	{
		name === 'arrow-right' && (
			<>
				<path d="M5 12h14" />
				<path d="m12 5 7 7-7 7" />
			</>
		)
	}
	{
		name === 'search' && (
			<>
				<circle cx="11" cy="11" r="8" />
				<path d="m21 21-4.3-4.3" />
			</>
		)
	}
	{name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
	{name === 'chevron-right' && <path d="m9 18 6-6-6-6" />}
	{
		name === 'file' && (
			<>
				<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
				<path d="M14 2v4a2 2 0 0 0 2 2h4" />
			</>
		)
	}
	{
		name === 'git' && (
			<>
				<line x1="6" x2="6" y1="3" y2="15" />
				<circle cx="18" cy="6" r="3" />
				<circle cx="6" cy="18" r="3" />
				<path d="M18 9a9 9 0 0 1-9 9" />
			</>
		)
	}
	{name === 'check' && <path d="M20 6 9 17l-5-5" />}
	{
		name === 'menu' && (
			<>
				<path d="M4 7h16" />
				<path d="M4 12h16" />
				<path d="M4 17h16" />
			</>
		)
	}
	{
		name === 'close' && (
			<>
				<path d="m6 6 12 12" />
				<path d="m18 6-12 12" />
			</>
		)
	}
</svg>
