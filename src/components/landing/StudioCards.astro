---
import Icon from './Icon.astro';
---

<section class="site-container grid gap-2 pb-20 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] lg:pb-32">
	<article class="relative flex min-h-[460px] flex-col gap-10 overflow-hidden rounded-xl bg-sage p-8 sm:p-12" data-reveal>
		<span
			class="pointer-events-none absolute -right-5 -bottom-[120px] text-[420px] leading-none tracking-[-0.05em] opacity-5 select-none"
			aria-hidden="true">K</span>
		<p class="font-label text-xs leading-none tracking-[0.08em] uppercase">Why we exist</p>
		<blockquote class="relative max-w-[660px] text-[1.75rem] leading-[1.18] tracking-[-0.028em] sm:text-4xl">
			“Most software is built to demo. We build the part that has to survive contact with real users.”
		</blockquote>
		<footer class="relative mt-auto flex flex-col gap-1">
			<p class="text-[15px] font-medium">Kilaslab</p>
			<p class="text-sm text-moss">Studio principle</p>
		</footer>
	</article>
	<article class="relative flex min-h-[460px] flex-col gap-10 overflow-hidden rounded-xl bg-gold p-8 sm:p-12" data-reveal style="--reveal-delay:80ms">
		<span
			class="pointer-events-none absolute -right-[150px] -bottom-[190px] size-[420px] rounded-full border border-ink"
			aria-hidden="true"></span>
		<p class="font-label text-xs leading-none tracking-[0.08em] uppercase">Open source</p>
		<blockquote class="relative max-w-[380px] text-[1.75rem] leading-[1.2] tracking-[-0.025em]">
			“The tools we publish are the ones we run ourselves.”
		</blockquote>
		<footer class="relative mt-auto flex items-end justify-between gap-6">
			<div class="flex flex-col gap-1">
				<p class="text-[15px] font-medium">Kilaslab</p>
				<p class="text-sm">github.com/kilaslab</p>
			</div>
			<a
				href="https://github.com/kilaslab"
				class="flex size-11 shrink-0 items-center justify-center rounded-full bg-ink text-gold hover:opacity-90"
				aria-label="Kilaslab on GitHub"
				target="_blank"
				rel="noreferrer"
			>
				<Icon name="arrow" class="size-4" />
			</a>
		</footer>
	</article>
</section>
