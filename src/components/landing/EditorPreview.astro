---
import Icon from './Icon.astro';

const tree = [
	{ kind: 'dir', label: 'app', indent: 'px-1.5', tone: 'muted', open: true },
	{ kind: 'dir', label: '(ops)', indent: 'pl-5', tone: 'muted', open: true },
	{ kind: 'dir', label: 'dispatch', indent: 'pl-[34px]', tone: 'muted', open: true },
	{ kind: 'file', label: 'page.tsx', indent: 'pl-12', tone: 'active', icon: 'flow' },
	{ kind: 'dir', label: 'invoices', indent: 'pl-[34px]', tone: 'faint', open: false },
	{ kind: 'dir', label: 'components', indent: 'px-1.5', tone: 'muted', open: true },
	{ kind: 'file', label: 'trip-card.tsx', indent: 'pl-8', tone: 'faint', icon: 'faint' },
	{ kind: 'file', label: 'invoice-total.tsx', indent: 'pl-8', tone: 'faint', icon: 'faint' },
	{ kind: 'dir', label: 'lib', indent: 'px-1.5', tone: 'muted', open: true },
	{ kind: 'file', label: 'db.ts', indent: 'pl-8', tone: 'faint', icon: 'faint' },
	{ kind: 'file', label: 'format.ts', indent: 'pl-8', tone: 'faint', icon: 'faint' },
	{ kind: 'dir', label: 'tests', indent: 'px-1.5', tone: 'muted', open: true },
	{ kind: 'file', label: 'invoice.test.ts', indent: 'pl-8', tone: 'faint', icon: 'faint' },
] as const;

const checks = [
	{ name: 'typecheck', detail: 'tsc --noEmit', time: '2.4s' },
	{ name: 'tests', detail: '41 passed', time: '1.8s' },
	{ name: 'build', detail: 'next build', time: '38s' },
	{ name: 'deploy', detail: 'production', time: '6s' },
];

const codeLines = [
	{ n: 1, body: '<span class="text-editor-faint">// app/(ops)/dispatch/page.tsx</span>' },
	{ n: 2, body: '<span class="text-editor-ai">import</span> { db } <span class="text-editor-ai">from</span> <span class="text-editor-flow">"@/lib/db"</span>;' },
	{ n: 3, body: '<span class="text-editor-ai">import</span> { money } <span class="text-editor-ai">from</span> <span class="text-editor-flow">"@/lib/format"</span>;' },
	{ n: 4, body: '' },
	{ n: 5, body: '<span class="text-editor-ai">export default async function</span> Dispatch() {' },
	{ n: 6, body: '<span class="pl-4"><span class="text-editor-ai">const</span> trips = <span class="text-editor-ai">await</span> db.trip<span class="text-editor-data">.findMany</span>({</span>' },
	{ n: 7, body: '<span class="pl-8"><span class="text-editor-ai">where</span>: { status: { <span class="text-editor-ai">in</span>: [<span class="text-editor-flow">"loaded"</span>, <span class="text-editor-flow">"transit"</span>] } },</span>' },
	{ n: 8, body: '<span class="pl-8">orderBy: { departedAt: <span class="text-editor-flow">"desc"</span> },</span>' },
	{ n: 9, body: '<span class="pl-4">});</span>' },
	{ n: 10, body: '<span class="pl-4"><span class="text-editor-ai">const</span> open = trips<span class="text-editor-data">.reduce</span>((sum, t) =&gt; sum + t<span class="text-editor-data">.amount</span>, <span class="text-editor-warn">0</span>);</span>' },
	{ n: 11, body: '' },
	{ n: 12, body: '<span class="pl-4"><span class="text-editor-ai">return</span> (</span>' },
	{ n: 13, body: '<span class="pl-8">&lt;<span class="text-editor-data">Board</span> title=<span class="text-editor-flow">"Dispatch"</span> total={money(open)}&gt;</span>' },
	{ n: 14, body: '<span class="pl-12">{trips<span class="text-editor-data">.map</span>((trip) =&gt; &lt;<span class="text-editor-data">TripCard</span> key={trip<span class="text-editor-data">.id</span>} trips={trip} /&gt;)}</span>' },
	{ n: 15, body: '<span class="pl-8">&lt;/<span class="text-editor-data">Board</span>&gt;</span>' },
	{ n: 16, body: '<span class="pl-4">);</span>' },
	{ n: 17, body: '}' },
];
---

<div
	class="editor-live relative flex w-full max-w-[1040px] flex-col overflow-hidden rounded-xl border border-editor-line bg-editor shadow-[0_40px_120px_-30px_rgba(14,28,11,0.65)]"
	data-live-editor
>
	<div class="flex h-11 shrink-0 items-center justify-between border-b border-editor-line-subtle bg-editor-panel px-3">
		<div class="flex min-w-0 items-center gap-2.5">
			<span class="flex size-[18px] shrink-0 items-center justify-center rounded-sm bg-gold text-[10px] font-bold text-soot">K</span>
			<span class="text-[12.5px] font-semibold tracking-[-0.1px] text-editor-fg">kilaslab</span>
			<span class="h-3.5 w-px shrink-0 bg-editor-line"></span>
			<span class="truncate font-code text-[11.5px] text-editor-faint">app/(ops)/dispatch/page.tsx</span>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			<span class="inline-flex h-6 items-center gap-1.5 rounded-md border border-editor-line px-2 font-code text-[11px] text-editor-muted">
				<Icon name="git" class="size-3" />
				main
			</span>
			<span
				class="deploy-chip inline-flex h-6 min-w-[92px] items-center justify-center gap-1 rounded-md bg-gold px-2.5 text-xs font-semibold text-soot"
				data-deploy="deployed"
			>
				<Icon name="check" class="deploy-check size-3" />
				<span data-deploy-label>Deployed</span>
			</span>
		</div>
	</div>

	<div class="flex min-h-0">
		<aside class="hidden w-[216px] shrink-0 flex-col border-r border-editor-line-subtle bg-editor-panel md:flex">
			<p class="flex h-[34px] items-center px-3 font-code text-[10.5px] tracking-[0.08em] text-editor-faint uppercase">Explorer</p>
			<ul class="flex flex-col gap-0.5 px-1.5 pt-0.5 pb-3">
				{
					tree.map((item) => (
						<li
							class:list={[
								'flex h-7 items-center gap-1.5 rounded-[5px] pr-1.5',
								item.indent,
								item.tone === 'active' && 'bg-editor-raised text-editor-fg',
								item.tone === 'muted' && 'text-editor-muted',
								item.tone === 'faint' && 'text-editor-faint',
							]}
						>
							{item.kind === 'dir' ? (
								<Icon name={item.open ? 'chevron-down' : 'chevron-right'} class="size-3 shrink-0 text-editor-faint" />
							) : (
								<Icon name="file" class:list={['size-3 shrink-0', item.icon === 'flow' ? 'text-editor-flow' : 'text-editor-faint']} />
							)}
							<span class="text-xs leading-none">{item.label}</span>
						</li>
					))
				}
			</ul>
		</aside>

		<div class="flex min-w-0 flex-1 flex-col">
			<div class="flex h-[34px] shrink-0 items-stretch border-b border-editor-line-subtle bg-editor-panel">
				<div class="inline-flex items-center gap-2 border-r border-editor-line-subtle bg-editor px-3 text-editor-fg">
					<Icon name="file" class="size-3 text-editor-flow" />
					<span class="text-xs">page.tsx</span>
				</div>
				<div class="inline-flex items-center gap-2 px-3 text-editor-faint">
					<Icon name="file" class="size-3" />
					<span class="text-xs">invoice.test.ts</span>
				</div>
			</div>

			<div class="overflow-x-auto bg-editor py-3 font-code text-[12.5px] leading-none text-editor-fg">
				{
					codeLines.map((line) => (
						<div
							class:list={['code-line flex h-[22px] items-center', line.n === 10 && 'is-active']}
							data-code-line={line.n}
							style={`--row:${line.n}`}
						>
							<span class="w-10 shrink-0 pr-3 text-right text-editor-faint">{line.n}</span>
							<span class="whitespace-pre" set:html={line.body} />
							{line.n === 10 && <span class="code-caret ml-0.5 inline-block h-[13px] w-0.5 align-middle bg-gold" aria-hidden="true" />}
						</div>
					))
				}
			</div>

			<div class="flex h-[184px] shrink-0 flex-col border-t border-editor-line-subtle bg-editor-canvas">
				<div class="flex h-8 items-center justify-between px-3">
					<div class="flex items-center gap-4 font-code text-[10.5px] tracking-[0.04em] uppercase">
						<span class="border-b-2 border-gold pb-1 text-editor-fg">Terminal</span>
						<span class="text-editor-faint">Problems</span>
					</div>
					<span class="inline-flex items-center gap-1.5 font-code text-[10.5px] text-editor-muted" data-status="passing">
						<span class="status-dot size-1.5 rounded-full bg-editor-ok"></span>
						<span data-status-label>passing</span>
					</span>
				</div>
				<div class="flex min-h-0 flex-1 flex-col overflow-x-auto px-3 pt-1 font-code text-[10.5px] text-editor-fg sm:text-[11.5px]">
					<p class="term-line flex h-[17px] items-center gap-1.5 whitespace-nowrap" data-line="cmd1">
						<span class="text-gold">$</span>
						<span class="whitespace-pre" data-type>git commit -m "dispatch: live open balance"</span>
						<span class="term-caret" aria-hidden="true"></span>
					</p>
					<p class="term-line flex h-[17px] items-center whitespace-nowrap text-editor-faint" data-line="out1">
						[main 4f8c2e1] 6 files changed, 148 insertions(+)
					</p>
					<p class="term-line flex h-[17px] items-center gap-1.5 whitespace-nowrap" data-line="cmd2">
						<span class="text-gold">$</span>
						<span class="whitespace-pre" data-type>pnpm verify && git push origin main</span>
						<span class="term-caret" aria-hidden="true"></span>
					</p>
					{
						checks.map((check, index) => (
							<p class="term-line flex h-[17px] items-center gap-3 whitespace-nowrap" data-line={`check${index}`} data-state="done">
								<span class="term-mark" aria-hidden="true">
									<span class="term-spin" />
									<Icon name="check" class="term-check size-3 text-editor-ok" />
								</span>
								<span class="w-16 shrink-0 text-editor-fg">{check.name}</span>
								<span class="text-editor-faint">{check.detail}</span>
								<span class="term-time ml-auto text-editor-muted">{check.time}</span>
							</p>
						))
					}
					<p class="term-line flex h-[17px] items-center gap-1.5 whitespace-nowrap text-editor-ok" data-line="done">
						<Icon name="check" class="size-3" />
						deployed to production in 6s
					</p>
				</div>
			</div>
		</div>
	</div>

	<div class="flex h-6 shrink-0 items-center justify-between gap-3 overflow-hidden border-t border-editor-line-subtle bg-editor-panel px-3 font-code text-[10.5px] whitespace-nowrap">
		<div class="flex min-w-0 items-center gap-1.5 text-editor-muted">
			<Icon name="git" class="size-3 shrink-0" />
			<span>main</span>
			<span class="hidden pl-3 text-editor-faint sm:inline">TypeScript</span>
			<span class="hidden pl-3 text-editor-faint md:inline">UTF-8</span>
		</div>
		<div class="flex shrink-0 items-center gap-3 text-editor-faint">
			<span class="hidden sm:inline">Ln 10, Col 60</span>
			<span>0 problems</span>
		</div>
	</div>
</div>

<style>
	.code-caret {
		animation: caretBlink 1.1s steps(2, jump-none) infinite;
	}

	@keyframes caretBlink {
		50% {
			opacity: 0;
		}
	}

	.is-live .code-line {
		animation: lineIn 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(var(--row) * 24ms);
	}

	@keyframes lineIn {
		from {
			opacity: 0;
			transform: translateY(3px);
		}
	}

	.code-line.is-patched {
		animation: patchFlash 900ms ease-out;
	}

	@keyframes patchFlash {
		0%,
		18% {
			background: color-mix(in oklab, var(--color-gold) 20%, transparent);
		}
		100% {
			background: var(--color-editor-raised);
		}
	}

	.is-live .term-line {
		opacity: 0;
		transform: translateY(2px);
		transition:
			opacity 240ms ease-out,
			transform 240ms ease-out;
	}

	.is-live .term-line.is-on {
		opacity: 1;
		transform: none;
	}

	.is-live.is-reset .term-line {
		transition: none;
	}

	.term-caret {
		display: none;
		width: 5px;
		height: 12px;
		background: var(--color-gold);
	}

	.is-live .term-line[data-state='typing'] .term-caret {
		display: inline-block;
		animation: caretBlink 900ms steps(2, jump-none) infinite;
	}

	.term-mark {
		position: relative;
		display: inline-flex;
		width: 12px;
		height: 12px;
		align-items: center;
		justify-content: center;
		flex: none;
	}

	:global(.term-check) {
		position: absolute;
		inset: 0;
	}

	.term-spin {
		display: none;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: 1.5px solid color-mix(in oklab, var(--color-editor-warn) 26%, transparent);
		border-top-color: var(--color-editor-warn);
		animation: termSpin 560ms linear infinite;
	}

	.is-live .term-line[data-state='running'] .term-spin {
		display: block;
	}

	.is-live .term-line[data-state='running'] :global(.term-check) {
		display: none;
	}

	@keyframes termSpin {
		to {
			transform: rotate(1turn);
		}
	}

	.term-time {
		transition: opacity 200ms ease-out;
	}

	.is-live .term-line[data-state='running'] .term-time,
	.is-live .term-line[data-state='pending'] .term-time {
		opacity: 0;
	}

	.status-dot {
		transition: background-color 200ms ease-out;
	}

	[data-status='idle'] .status-dot {
		background-color: var(--color-editor-faint);
	}

	[data-status='running'] .status-dot {
		background-color: var(--color-editor-warn);
		animation: statusPulse 900ms ease-in-out infinite;
	}

	[data-status='passing'] .status-dot {
		background-color: var(--color-editor-ok);
	}

	@keyframes statusPulse {
		50% {
			opacity: 0.35;
		}
	}

	.deploy-chip {
		transition:
			background-color 220ms ease-out,
			color 220ms ease-out;
	}

	.deploy-chip[data-deploy='idle'],
	.deploy-chip[data-deploy='deploying'] {
		background-color: var(--color-gold);
		color: var(--color-soot);
	}

	.deploy-chip[data-deploy='deployed'] {
		background-color: var(--color-editor-ok);
		color: #0b1c0f;
	}

	:global(.deploy-check) {
		display: none;
	}

	.deploy-chip[data-deploy='deployed'] :global(.deploy-check) {
		display: block;
	}

	.deploy-chip[data-deploy='deploying'] {
		animation: deployBreathe 1.4s ease-in-out infinite;
	}

	@keyframes deployBreathe {
		50% {
			opacity: 0.72;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.code-caret,
		.term-caret,
		.term-spin,
		.status-dot,
		.deploy-chip {
			animation: none !important;
		}
	}
</style>

<script>
	let cleanupEditor: (() => void) | null = null;

	const initEditor = () => {
		const root = document.querySelector<HTMLElement>('[data-live-editor]');
		if (!root || root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
		const codeLine = root.querySelector<HTMLElement>('[data-code-line="10"]');
		const status = root.querySelector<HTMLElement>('[data-status]');
		const statusLabel = root.querySelector<HTMLElement>('[data-status-label]');
		const deploy = root.querySelector<HTMLElement>('[data-deploy]');
		const deployLabel = root.querySelector<HTMLElement>('[data-deploy-label]');
		const checkLines = [...root.querySelectorAll<HTMLElement>('[data-line^="check"]')];
		const terminalLines = [...root.querySelectorAll<HTMLElement>('[data-line]')];

		const typeEls = terminalLines
			.map((line) => line.querySelector<HTMLElement>('[data-type]'))
			.filter((el): el is HTMLElement => Boolean(el));
		for (const el of typeEls) el.dataset.full = (el.textContent ?? '').trim();

		const LOOP = 8300;
		const RESET_AT = 7600;
		const timers: number[] = [];
		let frame = 0;
		let running = false;

		const later = (ms: number, fn: () => void) => {
			timers.push(window.setTimeout(fn, ms));
		};

		const clearTimers = () => {
			while (timers.length) window.clearTimeout(timers.pop());
			if (frame) cancelAnimationFrame(frame);
			frame = 0;
		};

		const showLine = (name: string) => {
			const line = root.querySelector<HTMLElement>(`[data-line="${name}"]`);
			line?.classList.add('is-on');
			return line;
		};

		const setStatus = (value: 'idle' | 'running' | 'passing') => {
			if (!status || !statusLabel) return;
			status.dataset.status = value;
			statusLabel.textContent = value;
		};

		const setDeploy = (value: 'idle' | 'deploying' | 'deployed') => {
			if (!deploy || !deployLabel) return;
			deploy.dataset.deploy = value;
			deployLabel.textContent = value === 'deployed' ? 'Deployed' : value === 'deploying' ? 'Deploying' : 'Deploy';
		};

		const resetStage = () => {
			// Clear the terminal as one motion, not a row-by-row fade: the run is
			// starting over, so the old output should not linger as ghosts. The
			// class disables row transitions while the rows are removed.
			root.classList.add('is-reset');
			void root.offsetHeight;
			for (const line of terminalLines) {
				line.classList.remove('is-on');
				if (line.dataset.line?.startsWith('check')) line.dataset.state = 'pending';
			}
			for (const el of typeEls) el.textContent = '';
			codeLine?.classList.remove('is-patched');
			setStatus('idle');
			setDeploy('idle');
			requestAnimationFrame(() => root.classList.remove('is-reset'));
		};

		const finalState = () => {
			root.classList.remove('is-live');
			for (const el of typeEls) el.textContent = el.dataset.full ?? '';
			for (const line of terminalLines) {
				line.classList.add('is-on');
				if (line.dataset.line?.startsWith('check')) line.dataset.state = 'done';
			}
			setStatus('passing');
			setDeploy('deployed');
			codeLine?.classList.remove('is-patched');
		};

		const typeLine = (line: HTMLElement) => {
			const el = line.querySelector<HTMLElement>('[data-type]');
			const full = el?.dataset.full ?? '';
			if (!el || !full) {
				line.dataset.state = 'done';
				return;
			}
			line.dataset.state = 'typing';
			const duration = full.length * 15;
			let start = 0;

			const step = (now: number) => {
				if (!start) start = now;
				const progress = Math.min(1, (now - start) / duration);
				el.textContent = full.slice(0, Math.round(full.length * progress));
				if (progress < 1) {
					frame = requestAnimationFrame(step);
					return;
				}
				frame = 0;
				line.dataset.state = 'done';
			};

			frame = requestAnimationFrame(step);
		};

		const cycle = () => {
			resetStage();

			later(140, () => {
				const line = showLine('cmd1');
				if (line) typeLine(line);
			});
			later(880, () => {
				showLine('out1');
				codeLine?.classList.add('is-patched');
			});
			later(1080, () => {
				const line = showLine('cmd2');
				if (line) typeLine(line);
			});
			later(2000, () => {
				setStatus('running');
				setDeploy('deploying');
			});

			checkLines.forEach((line, index) => {
				const at = 2060 + index * 560;
				later(at, () => {
					line.classList.add('is-on');
					line.dataset.state = 'running';
				});
				later(at + 480, () => {
					line.dataset.state = 'done';
				});
			});

			later(2060 + checkLines.length * 560 + 40, () => {
				showLine('done');
				setStatus('passing');
				setDeploy('deployed');
			});

			later(RESET_AT, () => {
				resetStage();
				codeLine?.classList.remove('is-patched');
			});
			later(LOOP, cycle);
		};

		const stop = () => {
			running = false;
			clearTimers();
			finalState();
		};

		const start = () => {
			if (running) return;
			running = true;

			if (motionQuery.matches) {
				running = false;
				finalState();
				return;
			}

			root.classList.add('is-live');
			cycle();
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) start();
					else stop();
				}
			},
			{ threshold: 0.15 },
		);
		observer.observe(root);

		motionQuery.addEventListener('change', () => {
			if (motionQuery.matches) {
				stop();
				finalState();
			} else {
				start();
			}
		});

		cleanupEditor = () => {
			stop();
			observer.disconnect();
		};
	};

	document.addEventListener('astro:page-load', () => initEditor());
	document.addEventListener('astro:before-swap', () => {
		cleanupEditor?.();
		cleanupEditor = null;
	});
	window.addEventListener('pagehide', () => {
		cleanupEditor?.();
		cleanupEditor = null;
	});

	initEditor();
</script>
