---
import Icon from './Icon.astro';

interface Props {
	current?: 'home' | 'notes';
}

const { current = 'home' } = Astro.props;
const home = (hash: string) => (current === 'home' ? hash : `/${hash}`);

const links = [
	{ href: home('#work'), label: 'Work', spy: 'work' },
	{ href: home('#open-source'), label: 'Open source', spy: 'open-source' },
];
---

<header class="site-nav sticky top-0 z-40" data-site-nav>
	<div class="site-nav-scrim" aria-hidden="true"></div>
	<div class="site-container relative flex h-16 items-center justify-between gap-6 lg:h-18">
		<a
			href={current === 'home' ? '#top' : '/'}
			class="flex items-center gap-2.5"
			aria-label="Kilaslab home"
		>
			<span class="flex size-[22px] items-center justify-center rounded-md bg-gold text-xs font-bold leading-none">K</span>
			<span class="text-lg font-medium leading-none tracking-[-0.4px]">Kilaslab</span>
		</a>

		<nav class="hidden items-center gap-x-8 md:flex" aria-label="Primary">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="nav-link font-label text-[13px] leading-none tracking-[0.06em] uppercase"
						data-spy={link.spy}
					>
						{link.label}
					</a>
				))
			}
			<a
				href="/notes"
				class:list={[
					'font-label text-[13px] leading-none tracking-[0.06em] uppercase',
					current === 'notes' ? 'rounded-full bg-sage px-3 py-2' : 'nav-link',
				]}
				aria-current={current === 'notes' ? 'page' : undefined}
			>
				Notes
			</a>
			<a
				href="https://github.com/kilaslab"
				class="nav-link inline-flex items-center gap-1.5 font-label text-[13px] leading-none tracking-[0.06em] uppercase"
				target="_blank"
				rel="noreferrer"
			>
				GitHub
				<Icon name="arrow" class="size-3.5" />
			</a>
			<a
				href={home('#start')}
				class="inline-flex h-9 items-center rounded-full bg-forest px-4 font-label text-[13px] leading-none tracking-[0.06em] text-paper uppercase transition-opacity duration-200 hover:opacity-90"
			>
				Start a project
			</a>
		</nav>

		<button
			type="button"
			class="nav-toggle -mr-2 inline-flex size-11 items-center justify-center rounded-full md:hidden"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="nav-panel"
			aria-label="Open menu"
		>
			<span class="nav-icon" data-icon="menu"><Icon name="menu" class="size-5" /></span>
			<span class="nav-icon" data-icon="close"><Icon name="close" class="size-5" /></span>
		</button>
	</div>

	<div id="nav-panel" class="nav-panel md:hidden" data-nav-panel inert>
		<div class="overflow-hidden">
			<nav class="site-container flex flex-col pt-1 pb-6" aria-label="Mobile">
				{
					links.map((link) => (
						<a
							href={link.href}
							class="flex h-12 items-center border-b border-rule/70 font-label text-[13px] tracking-[0.06em] uppercase"
							data-spy={link.spy}
						>
							{link.label}
						</a>
					))
				}
				<a
					href="/notes"
					class="flex h-12 items-center border-b border-rule/70 font-label text-[13px] tracking-[0.06em] uppercase"
					aria-current={current === 'notes' ? 'page' : undefined}
				>
					Notes
				</a>
				<a
					href="https://github.com/kilaslab"
					class="flex h-12 items-center gap-1.5 border-b border-rule/70 font-label text-[13px] tracking-[0.06em] uppercase"
					target="_blank"
					rel="noreferrer"
				>
					GitHub
					<Icon name="arrow" class="size-3.5" />
				</a>
				<a
					href={home('#start')}
					class="mt-5 inline-flex h-11 items-center justify-center rounded-full bg-forest px-4 font-label text-[13px] leading-none tracking-[0.06em] text-paper uppercase"
				>
					Start a project
				</a>
			</nav>
		</div>
	</div>
</header>

<style>
	.site-nav-scrim {
		position: absolute;
		inset: 0;
		border-bottom: 1px solid transparent;
		background: color-mix(in oklab, var(--color-paper) 84%, transparent);
		-webkit-backdrop-filter: blur(16px) saturate(1.08);
		backdrop-filter: blur(16px) saturate(1.08);
		opacity: 0;
		transition:
			opacity 280ms ease-out,
			border-color 280ms ease-out;
	}

	.site-nav.is-scrolled .site-nav-scrim,
	.site-nav.is-open .site-nav-scrim {
		opacity: 1;
		border-bottom-color: color-mix(in oklab, var(--color-rule) 80%, transparent);
	}

	.nav-link {
		position: relative;
		padding-block: 9px;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: 3px;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.nav-link:hover::after,
	.nav-link[data-active]::after {
		transform: scaleX(1);
	}

	.nav-toggle {
		position: relative;
		color: var(--color-ink);
	}

	.nav-icon {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		scale: 0.25;
		filter: blur(4px);
		transition:
			opacity 180ms ease-out,
			scale 220ms cubic-bezier(0.2, 0, 0, 1),
			filter 180ms ease-out;
	}

	.nav-toggle[aria-expanded='false'] [data-icon='menu'],
	.nav-toggle[aria-expanded='true'] [data-icon='close'] {
		opacity: 1;
		scale: 1;
		filter: blur(0);
	}

	.nav-panel {
		display: grid;
		grid-template-rows: 0fr;
		background: color-mix(in oklab, var(--color-paper) 94%, transparent);
		-webkit-backdrop-filter: blur(18px) saturate(1.08);
		backdrop-filter: blur(18px) saturate(1.08);
		box-shadow: inset 0 -1px 0 transparent;
		transition:
			grid-template-rows 340ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 260ms ease-out;
	}

	.nav-panel[data-open] {
		grid-template-rows: 1fr;
		box-shadow: inset 0 -1px 0 var(--color-rule);
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-icon,
		.nav-link::after,
		.nav-panel,
		.site-nav-scrim {
			transition: none;
		}
	}
</style>

<script>
	type NavState = {
		bound?: boolean;
		topObserver?: IntersectionObserver;
		sentinel?: HTMLElement;
		spy?: IntersectionObserver;
	};

	const state: NavState = ((window as unknown as { __kilasNav?: NavState }).__kilasNav ??= {});
	const mobileQuery = window.matchMedia('(min-width: 768px)');

	const closePanel = () => {
		const header = document.querySelector<HTMLElement>('[data-site-nav]');
		const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
		const panel = header?.querySelector<HTMLElement>('[data-nav-panel]');
		if (!header || !toggle || !panel) return;
		header.classList.remove('is-open');
		toggle.setAttribute('aria-expanded', 'false');
		toggle.setAttribute('aria-label', 'Open menu');
		panel.removeAttribute('data-open');
		panel.setAttribute('inert', '');
	};

	const bindOnce = (header: HTMLElement) => {
		if (state.bound) return;
		state.bound = true;

		const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
		const panel = header.querySelector<HTMLElement>('[data-nav-panel]');
		if (!toggle || !panel) return;

		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			header.classList.toggle('is-open', open);
			panel.toggleAttribute('data-open', open);
			if (open) panel.removeAttribute('inert');
			else panel.setAttribute('inert', '');
		});

		panel.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) closePanel();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closePanel();
		});

		mobileQuery.addEventListener('change', () => {
			if (mobileQuery.matches) closePanel();
		});
	};

	const watchTop = (header: HTMLElement) => {
		state.topObserver?.disconnect();
		state.sentinel?.remove();

		const sentinel = document.createElement('div');
		sentinel.setAttribute('aria-hidden', 'true');
		sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:8px;pointer-events:none;';
		document.body.prepend(sentinel);
		state.sentinel = sentinel;

		state.topObserver = new IntersectionObserver(
			([entry]) => header.classList.toggle('is-scrolled', !entry.isIntersecting),
			{ threshold: 0 },
		);
		state.topObserver.observe(sentinel);
	};

	const watchSections = (header: HTMLElement) => {
		state.spy?.disconnect();

		const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
		for (const link of links) {
			link.removeAttribute('data-active');
			link.removeAttribute('aria-current');
		}

		const sections = links
			.map((link) => document.getElementById(link.dataset.spy ?? ''))
			.filter((section): section is HTMLElement => Boolean(section));
		if (sections.length === 0) return;

		const active = new Set<Element>();

		state.spy = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) active.add(entry.target);
					else active.delete(entry.target);
				}

				const current = [...sections].reverse().find((section) => active.has(section));
				for (const link of links) {
					const on = Boolean(current) && link.dataset.spy === current?.id;
					link.toggleAttribute('data-active', on);
					if (on) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				}
			},
			{ rootMargin: '-96px 0px -75% 0px', threshold: 0 },
		);

		for (const section of sections) state.spy.observe(section);
	};

	const init = () => {
		const header = document.querySelector<HTMLElement>('[data-site-nav]');
		if (!header) return;

		bindOnce(header);
		header.classList.toggle('is-scrolled', window.scrollY > 8);
		watchTop(header);
		watchSections(header);
		closePanel();
	};

	document.addEventListener('astro:page-load', init);
	document.addEventListener('astro:before-swap', () => {
		state.topObserver?.disconnect();
		state.spy?.disconnect();
	});

	init();
</script>
